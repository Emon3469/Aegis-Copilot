OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
PINECONE_API_KEY=
TAVILY_API_KEY=

OPENAI_MODEL=gpt-4.1-mini
ANTHROPIC_MODEL=claude-haiku-5-5
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b
LLM_PROVIDERS=openai,anthropic,groq
LLM_TIMEOUT=30

EMBEDDING_PROVIDERS=pinecone
EMBEDDING_MODEL=text-embedding-3-large
EMBEDDING_DIMENSION=3072
PINECONE_EMBEDDING_MODEL=multilingual-e5-large
PINECONE_EMBEDDING_DIMENSION=1024
RERANK_MODEL=bge-reranker-v2-m3
RERANK_CANDIDATES=12
PINECONE_INDEX_NAME=aegis-copilot
PINECONE_NAMESPACE=incident-runbooks
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

TAVILY_SEARCH_DEPTH=basic
TOP_K=4
AUTO_INGEST=true
MAX_UPLOAD_MB=15

CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ORIGIN_REGEX=https://.*\.vercel\.app
